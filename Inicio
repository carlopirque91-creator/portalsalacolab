          <td><div style="width:36px; height:36px; border-radius:50%; overflow:hidden; border:1px solid var(--turq-main); background:rgba(0,0,0,0.4);">${miniAvatar}</div></td>
          <td><strong>${emp.center}</strong></td>
          <td style="font-weight:700;">${emp.name}</td>
          <td><span style="background:rgba(0,180,216,0.2); color:var(--turq-light); padding:3px 8px; border-radius:6px; font-weight:700;">${emp.dni}</span></td>
          <td><code style="color:#fde68a;">${emp.pass}</code></td>
          <td><div style="font-size:0.75rem;">${emp.email || '-'}</div><div style="font-size:0.72rem; color:var(--text-muted);">🎂 ${emp.birthDate || '-'}</div></td>
          <td>${fmt(emp.schedule.lun)}</td>
          <td>${fmt(emp.schedule.mar)}</td>
          <td>${fmt(emp.schedule.mie)}</td>
          <td>${fmt(emp.schedule.jue)}</td>
          <td>${fmt(emp.schedule.vie)}</td>
          <td>${fmt(emp.schedule.sab)}</td>
          <td>${fmt(emp.schedule.dom)}</td>
          <td style="white-space:nowrap;">
            <button class="btn-mini" onclick="selectEmpForEdit('${emp.id}')" title="Editar"><i class="fa-solid fa-pen"></i></button>
            <button class="btn-mini danger" onclick="deleteEmployeeByAdmin('${emp.id}')" title="Eliminar"><i class="fa-solid fa-trash"></i></button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function selectEmpForEdit(empId) {
      document.getElementById('adminEmpSelect').value = empId;
      fillAdminEmployeeForm(empId);
      window.scrollTo({ top: 100, behavior: 'smooth' });
    }

    function deleteEmployeeByAdmin(empId) {
      if (!confirm('¿Eliminar a este colaborador?')) return;
      employeesList = employeesList.filter(e => e.id !== empId);
      saveEmployeesDatabase();
      populateAdminSelectors();
      renderAdminMasterTable();
    }

    // ================= EDICIÓN EN VIVO CON LÁPIZ (✏️) =================
    function setupLiveEditableElements() {
      const savedEdits = JSON.parse(localStorage.getItem('portal_live_edits') || '{}');
      document.querySelectorAll('.editable-item').forEach(el => {
        const id = el.getAttribute('data-edit-id');
        if (savedEdits[id]) el.innerHTML = savedEdits[id];
        if (!el.querySelector('.edit-pencil-btn')) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'edit-pencil-btn';
          btn.innerHTML = '<i class="fa-solid fa-pencil"></i>';
          btn.onclick = (e) => { e.stopPropagation(); e.preventDefault(); openLiveEditModal(id, false); };
          el.appendChild(btn);
        }
      });

      document.querySelectorAll('.editable-img-wrapper').forEach(wrap => {
        const imgId = wrap.getAttribute('data-edit-id');
        const imgEl = document.getElementById(imgId);
        if (savedEdits[imgId] && imgEl) imgEl.src = savedEdits[imgId];
        if (!wrap.querySelector('.edit-pencil-btn')) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'edit-pencil-btn';
          btn.innerHTML = '<i class="fa-solid fa-pencil"></i>';
          btn.onclick = (e) => { e.stopPropagation(); e.preventDefault(); openLiveEditModal(imgId, true); };
          wrap.appendChild(btn);
        }
      });
    }

    function toggleLiveEditMode() {
      if (!activeUser || !activeUser.isAdmin) return;
      isLiveEditMode = !isLiveEditMode;
      document.body.classList.toggle('live-edit-active', isLiveEditMode);
      const btn = document.getElementById('liveEditBtn');
      btn.classList.toggle('active', isLiveEditMode);
      document.getElementById('liveEditStateText').textContent = isLiveEditMode ? 'ON (Clic en ✏️)' : 'OFF';
    }

    function openLiveEditModal(targetId, isImage) {
      currentEditTargetId = targetId;
      currentEditIsImage = isImage;
      document.getElementById('liveEditTextContainer').style.display = isImage ? 'none' : 'block';
      document.getElementById('liveEditImageContainer').style.display = isImage ? 'block' : 'none';

      if (isImage) {
        const imgEl = document.getElementById(targetId);
        document.getElementById('liveEditImgUrl').value = imgEl ? imgEl.src : '';
      } else {
        const el = document.querySelector(`[data-edit-id="${targetId}"]`);
        const clone = el.cloneNode(true);
        const p = clone.querySelector('.edit-pencil-btn');
        if (p) p.remove();
        document.getElementById('liveEditTextarea').value = clone.innerText.trim();
      }
      document.getElementById('liveEditModal').style.display = 'flex';
    }

    function previewUploadedEditImage(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => { document.getElementById('liveEditImgUrl').value = ev.target.result; };
      reader.readAsDataURL(file);
    }

    function saveLiveEditChange() {
      const savedEdits = JSON.parse(localStorage.getItem('portal_live_edits') || '{}');
      if (currentEditIsImage) {
        const newSrc = document.getElementById('liveEditImgUrl').value.trim();
        if (newSrc) {
          const imgEl = document.getElementById(currentEditTargetId);
          if (imgEl) imgEl.src = newSrc;
          savedEdits[currentEditTargetId] = newSrc;
        }
      } else {
        const newText = document.getElementById('liveEditTextarea').value.trim();
        const el = document.querySelector(`[data-edit-id="${currentEditTargetId}"]`);
        if (el) {
          el.textContent = newText;
          savedEdits[currentEditTargetId] = newText;
        }
      }
      localStorage.setItem('portal_live_edits', JSON.stringify(savedEdits));
      setupLiveEditableElements();
      closeLiveEditModal();
    }

    function closeLiveEditModal() {
      document.getElementById('liveEditModal').style.display = 'none';
    }

    // ================= RENDER PORTAL GENERAL =================
    function renderPortal(triggerWelcome = false) {
      document.getElementById('authWrapper').style.display = 'none';
      document.getElementById('appContainer').style.display = 'block';

      document.getElementById('topUserDni').textContent = `DNI: ${activeUser.dni}`;
      document.getElementById('topUserName').textContent = activeUser.name;
      document.getElementById('topCostCenter').textContent = `Centro de Costo: ${activeUser.center}`;

      renderAllUserAvatars(activeUser);
      fillPersonalProfileInputs(activeUser);
      renderZodiacBanner(activeUser);
      populateAdminSelectors();

      const adminTabBtn = document.getElementById('navAdminBtn');
      const adminBadge = document.getElementById('topAdminBadge');
      const simBtn = document.getElementById('btnSimulateUserView');
      const liveBtn = document.getElementById('liveEditBtn');
      const adminBalUpload = document.getElementById('adminBalotarioUploadCard');

      if (activeUser.isAdmin) {
        adminTabBtn.style.display = 'flex';
        adminBadge.style.display = 'inline-block';
        simBtn.style.display = 'inline-flex';
        liveBtn.style.display = 'inline-flex';
        adminBalUpload.style.display = 'block';
        renderAdminMasterTable();
        renderAttractiveSchedule(employeesList[0]);
        openSection('secAdmin', adminTabBtn);
      } else {
        adminTabBtn.style.display = 'none';
        adminBadge.style.display = 'none';
        simBtn.style.display = 'none';
        liveBtn.style.display = 'none';
        adminBalUpload.style.display = 'none';
        renderAttractiveSchedule(activeUser);
        openSection('secHorario', document.getElementById('navHorarioBtn'));
      }

      renderBalotarioResourcesList();

      if (triggerWelcome) {
        showWelcomePopup(activeUser);
      }
    }

    function togglePassVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }

    function openSection(secId, btn) {
      document.querySelectorAll('.tab-section').forEach(s => s.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(secId).classList.add('active');
      if (btn) btn.classList.add('active');
    }

    function checkQuiz(isCorrect) {
      const fb = document.getElementById('quizFeedback');
      fb.style.color = isCorrect ? '#70e000' : '#ef4444';
      fb.textContent = isCorrect
        ? '¡Correcto! Todo producto exhibido debe contar con su viñeta actualizada.'
        : 'Respuesta incorrecta. Intenta de nuevo.';
    }

    function logout() {
      sessionStorage.removeItem('portal_active_session');
      localStorage.removeItem('portal_persistent_session');
      activeUser = null;
      isLiveEditMode = false;
      isSimulatingCollaborator = false;
      document.body.classList.remove('live-edit-active');
      document.getElementById('simViewBanner').style.display = 'none';
      document.getElementById('appContainer').style.display = 'none';
      document.getElementById('authWrapper').style.display = 'flex';

      const savedCreds = JSON.parse(localStorage.getItem('portal_remember_credentials') || 'null');
      if (savedCreds && savedCreds.remember) {
        document.getElementById('loginDni').value = savedCreds.dni;
        document.getElementById('loginPass').value = savedCreds.pass;
      } else {
        document.getElementById('loginPass').value = '';
      }
    }

    // ================= INICIALIZACIÓN =================
    loadEmployeesDatabase();
    loadBalotarioResources();
    startFriendlyClock();
    setupLiveEditableElements();

    const rememberedCreds = JSON.parse(localStorage.getItem('portal_remember_credentials') || 'null');
    if (rememberedCreds && rememberedCreds.remember) {
      document.getElementById('loginDni').value = rememberedCreds.dni;
      document.getElementById('loginPass').value = rememberedCreds.pass;
      document.getElementById('rememberMe').checked = true;
    }

    const savedSession = sessionStorage.getItem('portal_active_session') || localStorage.getItem('portal_persistent_session');
    if (savedSession) {
      activeUser = JSON.parse(savedSession);
      renderPortal(false);
    }
  </script>
</body>
</html>
