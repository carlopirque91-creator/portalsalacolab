      background: rgba(239, 68, 68, 0.15);
      color: #fca5a5;
    }

    /* MODALES */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 300;
      padding: 20px;
    }

    .modal-box {
      width: 100%;
      max-width: 480px;
      background: var(--card-bg);
      border: 1px solid var(--turq-main);
      border-radius: var(--radius-lg);
      padding: 30px;
      text-align: center;
      box-shadow: 0 0 40px rgba(0, 180, 216, 0.3);
