    // ================= FORMATEADOR DE ENTRADA Y SALIDA =================
    function parseShiftEntryExit(shiftStr) {
      const clean = shiftStr.toUpperCase().replace('0:00', '').trim();
      if (clean.includes('DESCANSO')) return { type: 'REST', label: 'DÍA DE DESCANSO' };
      if (clean.includes('VACACIONES')) return { type: 'VAC', label: 'EN VACACIONES' };

      const match = clean.match(/(\d{1,2}:\d{2})\s*-\s*(\d{1,2}:?\d{2})/);
      if (match) {
        let entry = match[1];
        let exit = match[2];
        if (!exit.includes(':') && exit.length === 4) {
          exit = exit.slice(0, 2) + ':' + exit.slice(2);
        }
        return { type: 'WORK', entry, exit };
      }
      return { type: 'WORK', entry: clean, exit: '--:--' };
    }

