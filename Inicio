    function renderBalotarioResourcesList() {
      const container = document.getElementById('balotarioResourcesList');
      if (!container) return;

      if (balotarioResources.length === 0) {
        container.innerHTML = `<p style="color: var(--text-muted); font-size: 0.86rem;">No hay documentos publicados por el momento.</p>`;
        return;
      }

      const canDelete = activeUser && activeUser.isAdmin && !isSimulatingCollaborator;

      container.innerHTML = balotarioResources.map(res => {
        const isPdf = res.type === 'pdf';
        const downloadAttr = isPdf ? `download="${res.fileName || 'Balotario.pdf'}"` : `target="_blank" rel="noopener"`;
        return `
          <div class="resource-card">
            <div class="resource-info">
              <div class="resource-icon ${isPdf ? '' : 'link-type'}">
                <i class="fa-solid ${isPdf ? 'fa-file-pdf' : 'fa-link'}"></i>
              </div>
              <div>
                <div style="font-weight: 700; font-size: 0.95rem; color: #fff;">${res.title}</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                  Publicado el ${res.date} • ${isPdf ? `Archivo PDF (${res.fileName})` : 'Enlace externo de estudio'}
                </div>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <a href="${res.url}" ${downloadAttr} class="btn-download">
                <i class="fa-solid fa-download"></i> ${isPdf ? 'Descargar PDF' : 'Abrir Enlace'}
              </a>
              ${canDelete ? `
                <button class="btn-mini danger" onclick="deleteBalotarioResource('${res.id}')" title="Eliminar documento" style="padding: 9px 11px;">
                  <i class="fa-solid fa-trash"></i>
                </button>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function handleAdminAddBalotario(e) {
      e.preventDefault();
      const title = document.getElementById('balResTitle').value.trim();
      const fileInput = document.getElementById('balResFile');
      const linkInput = document.getElementById('balResLink').value.trim();

      if (fileInput.files && fileInput.files[0]) {
        const file = fileInput.files[0];
        const reader = new FileReader();
        reader.onload = (ev) => {
          balotarioResources.unshift({
            id: 'res_' + Date.now(),
            title,
            type: 'pdf',
            url: ev.target.result,
            fileName: file.name,
            date: new Date().toLocaleDateString('es-PE')
          });
          try {
            saveBalotarioResources();
            renderBalotarioResourcesList();
            document.getElementById('balResTitle').value = '';
            fileInput.value = '';
            document.getElementById('balResLink').value = '';
            alert(`¡El PDF "${file.name}" fue subido y ya está listo para que los colaboradores lo descarguen!`);
          } catch (storageErr) {
            alert('El archivo PDF es demasiado pesado para la memoria local del navegador. Usa un archivo más ligero o pega un enlace de Google Drive.');
          }
        };
        reader.readAsDataURL(file);
      } else if (linkInput) {
        balotarioResources.unshift({
          id: 'res_' + Date.now(),
          title,
          type: 'link',
          url: linkInput,
          fileName: '',
          date: new Date().toLocaleDateString('es-PE')
        });
        saveBalotarioResources();
        renderBalotarioResourcesList();
        document.getElementById('balResTitle').value = '';
        document.getElementById('balResLink').value = '';
        alert('¡Enlace de balotario publicado para todos los colaboradores!');
      } else {
        alert('Por favor, selecciona un archivo PDF de tu computadora o pega un enlace.');
      }
    }

