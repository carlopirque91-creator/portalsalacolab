<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Sala de Ventas - Colaboradores</title>
  
  <!-- ICONO DE PÁGINA (FAVICON SVG PERSONALIZADO) -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%2300b4d8'/%3E%3Cstop offset='100%25' stop-color='%23f59e0b'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='16' fill='url(%23g)'/%3E%3Cpath d='M18 22h28l-3 24H21L18 22zm7-6a7 7 0 0 1 14 0v4H25v-4z' fill='%23fff'/%3E%3C/svg%3E">

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- SheetJS (Lectura de Excel) & PDF.js (Lectura de PDF) -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    :root {
      --bg-dark: #070b14;
      --card-bg: rgba(17, 24, 39, 0.92);
      --card-border: rgba(255, 255, 255, 0.11);
      --turq-main: #00b4d8;
      --turq-dark: #0077b6;
      --turq-light: #e0f7fa;
      --accent-green: #10b981;
      --accent-lime: #70e000;
      --accent-gold: #f59e0b;
      --accent-purple: #a855f7;
      --danger: #ef4444;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --radius-lg: 22px;
      --radius-md: 14px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
    }

    body {
      min-height: 100vh;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 12% 12%, rgba(0, 180, 216, 0.16) 0%, transparent 42%),
        radial-gradient(circle at 88% 85%, rgba(245, 158, 11, 0.12) 0%, transparent 42%);
      color: var(--text-main);
    }

    /* ================= MODO EDICIÓN EN VIVO (LÁPIZ ✏️) ================= */
    .editable-item, .editable-img-wrapper {
      position: relative;
      transition: all 0.2s ease;
    }

    body.live-edit-active .editable-item {
      outline: 1.5px dashed rgba(245, 158, 11, 0.85);
      outline-offset: 4px;
      border-radius: 6px;
      padding-right: 30px !important;
      cursor: pointer;
    }

    body.live-edit-active .editable-img-wrapper {
      outline: 2px dashed var(--accent-gold);
      border-radius: var(--radius-md);
    }

    .edit-pencil-btn {
      display: none;
      position: absolute;
      top: 50%;
      right: 4px;
      transform: translateY(-50%);
      width: 25px;
      height: 25px;
      border-radius: 50%;
      background: var(--accent-gold);
      color: #000;
      border: none;
      font-size: 0.75rem;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 3px 10px rgba(0,0,0,0.6);
      z-index: 30;
    }

    .editable-img-wrapper .edit-pencil-btn {
      top: 12px;
      right: 12px;
      transform: none;
      width: 34px;
      height: 34px;
      font-size: 0.9rem;
    }

    body.live-edit-active .edit-pencil-btn {
      display: inline-flex;
    }

    /* ================= LOGIN ================= */
    .auth-wrapper {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      background: linear-gradient(135deg, rgba(7, 11, 20, 0.88), rgba(17, 24, 39, 0.92)),
                  url('https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat fixed;
    }

    .auth-card {
      width: 100%;
      max-width: 440px;
      background: var(--card-bg);
      backdrop-filter: blur(18px);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 36px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 30px rgba(0, 180, 216, 0.15);
    }

    .brand-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .brand-icon {
      width: 68px;
      height: 68px;
      border-radius: 18px;
      background: linear-gradient(135deg, var(--turq-main), var(--accent-gold));
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.9rem;
      color: #fff;
      margin-bottom: 12px;
      box-shadow: 0 8px 25px rgba(0, 180, 216, 0.35);
      overflow: hidden;
      padding: 2px;
    }

    .brand-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 16px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-size: 0.84rem;
      font-weight: 500;
      margin-bottom: 6px;
      color: #cbd5e1;
    }

    .input-box {
      position: relative;
    }

    .input-box i.left-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--turq-main);
      pointer-events: none;
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 1rem;
      padding: 4px 6px;
    }

    .toggle-password:hover {
      color: var(--turq-main);
    }

    input, select, textarea {
      width: 100%;
      padding: 12px 42px 12px 40px;
      background: rgba(0, 0, 0, 0.42);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      color: #fff;
      font-size: 0.92rem;
      outline: none;
      transition: all 0.25s ease;
    }

    select option {
      background: #111827;
      color: #fff;
    }

    input:focus, select:focus, textarea:focus {
      border-color: var(--turq-main);
      box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.15);
    }

    .remember-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      font-size: 0.85rem;
      color: #cbd5e1;
    }

    .remember-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      user-select: none;
    }

    .remember-label input[type="checkbox"] {
      width: 17px;
      height: 17px;
      accent-color: var(--turq-main);
      cursor: pointer;
    }

    .btn {
      width: 100%;
      padding: 13px 20px;
      border: none;
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.25s ease;
    }

    .btn-turq {
      background: linear-gradient(135deg, var(--turq-main), var(--turq-dark));
      color: #fff;
      box-shadow: 0 6px 18px rgba(0, 180, 216, 0.3);
    }

    .btn-turq:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0, 180, 216, 0.45);
    }

    .btn-gold {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #000;
      box-shadow: 0 6px 18px rgba(245, 158, 11, 0.25);
    }

    .alert-box {
      padding: 11px 14px;
      border-radius: 10px;
      font-size: 0.84rem;
      margin-bottom: 16px;
      display: none;
      align-items: center;
      gap: 8px;
    }

    .alert-error {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid var(--danger);
      color: #fca5a5;
    }

    /* ================= BARRA DE SIMULACIÓN DE VISTA DE COLABORADOR ================= */
    .sim-banner {
      display: none;
      background: linear-gradient(90deg, #f59e0b, #d97706);
      color: #000;
      padding: 10px 24px;
      font-weight: 700;
      font-size: 0.88rem;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    }

    .sim-banner select {
      width: auto;
      padding: 6px 12px;
      background: #111827;
      color: #fff;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.84rem;
    }

    /* ================= TOPBAR Y AVATAR CHIP ================= */
    .app-container {
      display: none;
      min-height: 100vh;
    }

    .topbar {
      background: rgba(17, 24, 39, 0.96);
      border-bottom: 1px solid var(--card-border);
      padding: 12px 26px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(12px);
      flex-wrap: wrap;
      gap: 12px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .admin-action-pill {
      display: none;
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid var(--accent-gold);
      color: #fde68a;
      padding: 7px 13px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    .admin-action-pill:hover, .admin-action-pill.active {
      background: var(--accent-gold);
      color: #000;
    }

    .user-chip {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.05);
      padding: 5px 14px 5px 6px;
      border-radius: 30px;
      border: 1px solid var(--card-border);
      cursor: pointer;
      transition: border 0.2s;
    }

    .user-chip:hover {
      border-color: var(--turq-main);
    }

    .avatar-circle-sm {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(0, 180, 216, 0.2);
      border: 2px solid var(--turq-main);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .user-chip .dni-badge {
      background: var(--turq-main);
      color: #000;
      font-weight: 800;
      font-size: 0.74rem;
      padding: 3px 8px;
      border-radius: 12px;
    }

    .user-chip .admin-badge {
      background: var(--accent-gold);
      color: #000;
      font-weight: 800;
      font-size: 0.74rem;
      padding: 3px 8px;
      border-radius: 12px;
      display: none;
    }

    .btn-logout {
      background: rgba(239, 68, 68, 0.15);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.3);
      padding: 8px 14px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 0.84rem;
      font-weight: 600;
    }

    /* ================= WIDGETS SUPERIORES: RELOJ, CLIMA Y HORÓSCOPO ================= */
    .ambient-bar {
      max-width: 1240px;
      margin: 18px auto 0;
      padding: 0 20px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 14px;
    }

    .ambient-widget {
      background: linear-gradient(135deg, rgba(17, 24, 39, 0.92), rgba(30, 41, 59, 0.85));
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: 15px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }

    .ambient-icon {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      flex-shrink: 0;
    }

    .zodiac-banner {
      max-width: 1240px;
      margin: 14px auto 0;
      padding: 0 20px;
    }

    .zodiac-card {
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(0, 180, 216, 0.14));
      border: 1px solid rgba(168, 85, 247, 0.45);
      border-radius: var(--radius-lg);
      padding: 16px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
    }

    .zodiac-symbol {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: rgba(168, 85, 247, 0.28);
      border: 1px solid rgba(168, 85, 247, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.7rem;
    }

    /* ================= TARJETA DESTACADA: TU HORARIO DE HOY ================= */
    .today-hero-card {
      background: linear-gradient(135deg, rgba(0, 180, 216, 0.22) 0%, rgba(16, 185, 129, 0.18) 100%);
      border: 2px solid var(--turq-main);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
      margin-bottom: 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
      box-shadow: 0 12px 35px rgba(0, 180, 216, 0.18);
    }

    .today-hero-left {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .hero-avatar-box {
      width: 78px;
      height: 78px;
      border-radius: 22px;
      background: rgba(9, 13, 22, 0.7);
      border: 2px solid var(--accent-gold);
      overflow: hidden;
      cursor: pointer;
      position: relative;
      flex-shrink: 0;
      box-shadow: 0 8px 20px rgba(0,0,0,0.4);
    }

    .hero-avatar-box::after {
      content: '✏️';
      position: absolute;
      bottom: 2px;
      right: 2px;
      font-size: 0.65rem;
      background: rgba(0,0,0,0.7);
      border-radius: 50%;
      padding: 2px;
    }

    .today-shifts-box {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    .io-pill-group {
      background: rgba(9, 13, 22, 0.78);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 14px;
      padding: 12px 18px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .io-time-block {
      text-align: center;
    }

    .io-time-block .io-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      font-weight: 700;
      display: block;
      margin-bottom: 3px;
    }

    .io-time-block .io-val {
      font-family: 'Outfit', sans-serif;
      font-size: 1.3rem;
      font-weight: 800;
      color: #fff;
    }

    /* ================= NAVEGACIÓN ================= */
    .nav-bar {
      display: flex;
      gap: 10px;
      max-width: 1240px;
      margin: 18px auto 0;
      padding: 0 20px;
      overflow-x: auto;
    }

    .nav-btn {
      padding: 12px 18px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.88rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
      transition: all 0.25s ease;
    }

    .nav-btn.active, .nav-btn:hover {
      background: linear-gradient(135deg, rgba(0, 180, 216, 0.22), rgba(0, 119, 182, 0.2));
      border-color: var(--turq-main);
      color: #fff;
      transform: translateY(-1px);
    }

    .nav-btn.admin-tab {
      border-color: rgba(245, 158, 11, 0.5);
      color: #fde68a;
      background: rgba(245, 158, 11, 0.1);
      display: none;
    }

    .nav-btn.admin-tab.active, .nav-btn.admin-tab:hover {
      background: var(--accent-gold);
      color: #000;
    }

    .main-content {
      max-width: 1240px;
      margin: 20px auto 60px;
      padding: 0 20px;
    }

    .tab-section {
      display: none;
      animation: fadeIn 0.3s ease;
    }

    .tab-section.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ================= TARJETAS DE HORARIO SEMANAL ATRACTIVAS (ENTRADA / SALIDA) ================= */
    .emp-summary-pills {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
      margin-bottom: 22px;
    }

    .emp-pill-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .days-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 18px;
    }

    .day-card {
      background: linear-gradient(160deg, rgba(17, 24, 39, 0.95), rgba(15, 23, 42, 0.85));
      border: 1px solid var(--card-border);
      border-radius: 18px;
      padding: 20px;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .day-card:hover {
      transform: translateY(-5px);
      border-color: var(--turq-main);
      box-shadow: 0 12px 28px rgba(0, 180, 216, 0.15);
    }

    .day-card.today {
      border: 2px solid var(--turq-main);
      box-shadow: 0 0 25px rgba(0, 180, 216, 0.25);
    }

    .day-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .day-name {
      font-family: 'Outfit', sans-serif;
      font-size: 1.15rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .entry-exit-card {
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid rgba(0, 180, 216, 0.3);
      border-radius: 12px;
      padding: 12px;
      margin-top: 8px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
    }

    .time-col {
      text-align: center;
    }

    .time-col .t-badge {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      display: block;
      margin-bottom: 4px;
    }

    .time-col .t-hour {
      font-family: 'Outfit', sans-serif;
      font-size: 1.05rem;
      font-weight: 800;
      color: #fff;
    }

    .rest-banner-pill {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.45);
      color: #6ee7b7;
      border-radius: 12px;
      padding: 16px 12px;
      text-align: center;
      font-weight: 800;
      font-size: 0.92rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .vac-banner-pill {
      background: rgba(245, 158, 11, 0.16);
      border: 1px solid rgba(245, 158, 11, 0.45);
      color: #fde68a;
      border-radius: 12px;
      padding: 16px 12px;
      text-align: center;
      font-weight: 800;
      font-size: 0.92rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    /* ================= CREADOR / EDITOR DE AVATAR PERSONALIZADO ================= */
    .avatar-studio-card {
      background: linear-gradient(145deg, rgba(17, 24, 39, 0.95), rgba(30, 41, 59, 0.9));
      border: 1px solid rgba(0, 180, 216, 0.35);
      border-radius: var(--radius-lg);
      padding: 26px;
      margin-bottom: 24px;
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 28px;
      align-items: center;
    }

    @media (max-width: 760px) {
      .avatar-studio-card {
        grid-template-columns: 1fr;
        text-align: center;
      }
    }

    .avatar-preview-stage {
      width: 190px;
      height: 190px;
      margin: 0 auto;
      border-radius: 28px;
      background: radial-gradient(circle, rgba(0, 180, 216, 0.25), rgba(9, 13, 22, 0.9));
      border: 3px solid var(--turq-main);
      box-shadow: 0 12px 30px rgba(0, 180, 216, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .swatch-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .color-swatch {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.25);
      cursor: pointer;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }

    .color-swatch:hover, .color-swatch.active {
      transform: scale(1.18);
      border-color: #fff;
      box-shadow: 0 0 10px rgba(255,255,255,0.5);
