    }

    .upload-dropzone {
      border: 2px dashed rgba(0, 180, 216, 0.5);
      background: rgba(0, 180, 216, 0.06);
      border-radius: var(--radius-lg);
      padding: 24px;
      text-align: center;
      cursor: pointer;
      margin-bottom: 14px;
    }

    .table-responsive {
      overflow-x: auto;
      border-radius: 12px;
      border: 1px solid var(--card-border);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
      min-width: 1020px;
    }

    th, td {
      padding: 11px 10px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    th {
      background: rgba(0, 180, 216, 0.14);
      color: var(--turq-light);
      font-weight: 700;
    }

    .btn-mini {
      padding: 5px 9px;
      font-size: 0.74rem;
      border-radius: 6px;
      border: 1px solid rgba(0, 180, 216, 0.4);
      background: rgba(0, 180, 216, 0.15);
      color: var(--turq-light);
